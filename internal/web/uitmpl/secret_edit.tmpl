{{define "content"}}
<div class="secret-heading">
  <h2 class="ui-page-heading">{{if .Creating}}New secret{{else}}{{.Path}}{{end}}</h2>
</div>
<p class="ui-page-subheading">
  {{if .Creating}}The name is relative to <code>{{.Prefix}}/</code>. Add one row per field.
  {{else}}Renaming moves the secret. Only the fields you change are written.{{end}}
</p>
{{if .FormError}}<div class="error-banner">{{.FormError}}</div>{{end}}
<div class="enrol-card">
  <form class="secret-edit-form" method="post" action="{{if .Creating}}/ui/secret-editor/create{{else}}/ui/secret-editor/save{{end}}">
    <input type="hidden" name="prefix" value="{{.Prefix}}">
    {{if not .Creating}}<input type="hidden" name="path" value="{{.Path}}">{{end}}
    {{range .Original}}<input type="hidden" name="original_field" value="{{.}}">{{end}}

    <label class="enrol-prompt-label" for="secret-name">Name</label>
    <div class="secret-name-row">
      <span class="secret-name-prefix">{{.Prefix}}/</span>
      <input id="secret-name" name="name" class="enrol-prompt-input" value="{{.Name}}"
             autocomplete="off" spellcheck="false" placeholder="my-secret" required>
    </div>

    <label class="enrol-prompt-label">Fields</label>
    <div id="secret-field-rows" class="secret-field-rows">
      {{range .Rows}}{{template "secret-field-row" .}}{{end}}
    </div>
    {{template "secret-add-field-btn" .}}

    <div class="enrol-prompt-actions">
      <button type="submit" class="enrol-btn-primary">{{if .Creating}}Create{{else}}Save{{end}}</button>
      <a class="enrol-btn-secondary" href="{{.CancelURL}}">Cancel</a>
    </div>
  </form>
</div>
{{end}}
