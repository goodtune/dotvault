{{define "content"}}
<div class="secret-heading">
  <h2>{{.Path}}</h2>
  {{if .VaultSecretURL}}<a class="vault-link" href="{{.VaultSecretURL}}" target="_blank" rel="noopener noreferrer">View in Vault &#8599;</a>{{end}}
  {{if and .Editable (not .EditBlocked)}}<a class="enrol-btn-primary" href="{{.EditURL}}">Edit</a>{{end}}
</div>
<div class="secret-meta">Version: {{.SecretVersion}}</div>
{{if .FormError}}<div class="error-banner">{{.FormError}}</div>{{end}}
{{if .Managed}}<div class="secret-meta">Managed by an enrolment &mdash; dotvault rewrites this secret, so it cannot be edited here.</div>{{end}}
{{if .EditBlocked}}<div class="secret-meta">Not editable here &mdash; {{.EditBlocked}}</div>{{end}}
<table class="field-table">
  <thead><tr><th>Field</th><th>Value</th><th></th></tr></thead>
  <tbody>
    {{range .Fields}}<tr>
      <td class="field-name">{{.Name}}</td>
      {{template "masked-cell" .}}
      <td class="field-actions">{{template "eye-btn" .}}{{template "copy-btn" .}}</td>
    </tr>{{end}}
  </tbody>
</table>
{{if .Editable}}
<div class="enrol-card secret-delete-card">
  <form class="secret-delete-form" method="post" action="/ui/secret-editor/delete">
    <input type="hidden" name="path" value="{{.Path}}">
    <label class="enrol-prompt-label" for="secret-delete-confirm">Delete this secret and every version of it. This cannot be undone &mdash; type <code>{{.Leaf}}</code> to confirm.</label>
    <div class="ssh-row-confirm">
      <input id="secret-delete-confirm" name="confirm" class="enrol-prompt-input" value=""
             autocomplete="off" spellcheck="false" placeholder="{{.Leaf}}" required>
      <button type="submit" class="enrol-btn-danger">Delete</button>
    </div>
  </form>
</div>
{{end}}
{{end}}
