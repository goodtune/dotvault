{{/* Secret field-table cell and button fragments. Each carries a stable id
     so a datastar patch swaps exactly one element; the reveal cell re-masks
     itself after 30 seconds via a delayed @get, matching the SPA's client-side
     auto-hide. */}}

{{define "masked-cell"}}<td id="ui-val-{{.ID}}" class="field-value"><span class="masked">&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;</span></td>{{end}}

{{define "revealed-cell"}}<td id="ui-val-{{.ID}}" class="field-value" data-init__delay.30s="@get('{{.MaskURL}}')"><code>{{.Value}}</code></td>{{end}}

{{define "eye-btn"}}<button id="ui-eye-{{.ID}}" class="reveal-btn" title="Reveal" data-on:click="@get('{{.RevealURL}}')">&#128065;</button>{{end}}

{{define "eye-btn-open"}}<button id="ui-eye-{{.ID}}" class="reveal-btn" title="Hide" data-on:click="@get('{{.MaskURL}}')">&#128065;&#65039;</button>{{end}}

{{define "copy-btn"}}<button id="ui-copy-{{.ID}}" class="copy-btn" title="Copy to this machine&#39;s clipboard" data-on:click="@post('{{.CopyURL}}')">&#128203;</button>{{end}}

{{/* remotes-panel wraps the managed-remotes table (or its empty state) in a
     stable id so the /ui/sse/ssh stream can re-render it wholesale — that
     also covers remotes appearing or disappearing (e.g. added via the CLI)
     without per-row id bookkeeping. Data: []uiRemoteRow. */}}
{{define "remotes-panel"}}<div id="ui-ssh-remotes-panel">
  {{if .}}<table class="ssh-table">
    <thead><tr><th>Host</th><th>Port</th><th>Remote socket</th><th>State</th><th>Reconnects</th><th>Last error</th></tr></thead>
    <tbody>
      {{range .}}<tr>
        <td><a href="{{.Href}}">{{.Host}}</a></td>
        <td>{{.Port}}</td>
        <td><code>{{if .RemoteSocket}}{{.RemoteSocket}}{{else}}&mdash;{{end}}</code></td>
        <td><span class="{{.PillClass}}">{{.StateLabel}}</span></td>
        <td>{{.Reconnects}}</td>
        <td>{{if .LastError}}<span class="ssh-error-text">{{.LastError}}</span>{{else}}&mdash;{{end}}</td>
      </tr>{{end}}
    </tbody>
  </table>{{else}}<p class="config-empty">No SSH remotes configured yet.</p>{{end}}
</div>{{end}}

{{/* remote-state is the live state line on a remote's detail page. Data:
     uiRemoteRow. */}}
{{define "remote-state"}}<div class="secret-meta" id="ui-remote-state"><span class="ui-dot ui-dot-{{.Dot}} ui-dot-inline"></span><span class="{{.PillClass}}">{{.StateLabel}}</span>{{if .LastError}} <span class="ssh-error-text">{{.LastError}}</span>{{end}}</div>{{end}}

{{define "copy-btn-done"}}<button id="ui-copy-{{.ID}}" class="copy-btn copied" title="Copied!" data-init__delay.2s="@get('{{.CopyBtnURL}}')">&#9989;</button>{{end}}

{{/* A row of the secret's field table has two shapes. secret-row is the
     read-only one, masked like every other secret on this surface. Its
     pencil is gated on .Editable — set from the same predicate the edit-row
     handler enforces — because offering an edit the request would refuse is
     precisely what EditPolicy.Allows exists to prevent, and with the default
     empty web.editable_paths that would be every row of every secret;
     secret-row-edit is the same row turned into inputs by the pencil. They
     replace each other in place (both carry the same id) so nothing else on
     the page — including another row mid-edit — is disturbed. */}}
{{define "secret-row"}}<tr id="secret-row-{{.ID}}">
  <td class="field-name">{{.Name}}</td>
  {{template "masked-cell" .}}
  <td class="field-actions">{{template "eye-btn" .}}{{template "copy-btn" .}}{{if .Editable}}{{template "pencil-btn" .}}{{end}}</td>
</tr>{{end}}

{{/* The value is a <textarea>, not an <input>: the HTML value sanitization
     algorithm strips CR and LF from a text input, which would silently
     flatten a PEM private key. The literal newline before {{.Value}} is the
     idiom the HTML standard prescribes — the parser drops a newline right
     after the start tag, so a value that itself begins with one would lose
     it; the emitted newline is the one that gets dropped.

     `version` is the point of the whole row: it is the version the row was
     rendered from, and the save is a check-and-set against it, so an edit
     made against a stale view is refused rather than overwriting whoever
     wrote in between. */}}
{{define "secret-row-edit"}}<tr id="secret-row-{{.ID}}" class="field-row-editing">
  <td colspan="3">
    <form class="field-edit-form" method="post" action="/ui/secrets-edit/field">
      <input type="hidden" name="path" value="{{.Path}}">
      <input type="hidden" name="version" value="{{.Version}}">
      <input type="hidden" name="was" value="{{.Name}}">
      <div class="field-edit-row">
        <input class="secret-field-name" name="field" value="{{.Name}}"
               autocomplete="off" spellcheck="false" placeholder="field" aria-label="Field name" required>
        <textarea class="secret-field-value" name="value" rows="{{.Rows}}" wrap="off"
                  autocomplete="off" spellcheck="false" aria-label="Field value">
{{- "\n"}}{{.Value}}</textarea>
      </div>
      <div class="field-edit-actions">
        <button type="submit" class="enrol-btn-primary">Save</button>
        <button type="button" class="enrol-btn-secondary" data-on:click="@get('{{.CancelURL}}')">Cancel</button>
        <button type="submit" name="delete" value="1" class="enrol-btn-danger field-remove">Remove field</button>
      </div>
    </form>
  </td>
</tr>{{end}}

{{/* The blank row that adds a field. Same form, no `was`, so the save is an
     addition rather than a rename. */}}
{{define "secret-add-row"}}<tr id="secret-add-row" data-signals="{addOpen: false}">
  <td colspan="3">
    <button type="button" class="enrol-btn-secondary" data-show="!$addOpen"
            data-on:click="$addOpen = true">Add field</button>
    <form class="field-edit-form" method="post" action="/ui/secrets-edit/field"
          data-show="$addOpen" style="display: none">
      <input type="hidden" name="path" value="{{.Path}}">
      <input type="hidden" name="version" value="{{.Version}}">
      <div class="field-edit-row">
        <input class="secret-field-name" name="field" value=""
               autocomplete="off" spellcheck="false" placeholder="field" aria-label="Field name" required>
        <textarea class="secret-field-value" name="value" rows="1" wrap="off"
                  autocomplete="off" spellcheck="false" placeholder="value" aria-label="Field value">
{{- "\n"}}</textarea>
      </div>
      <div class="field-edit-actions">
        <button type="submit" class="enrol-btn-primary">Add</button>
        <button type="button" class="enrol-btn-secondary" data-on:click="$addOpen = false">Cancel</button>
      </div>
    </form>
  </td>
</tr>{{end}}

{{define "pencil-btn"}}<button class="icon-btn" title="Edit this field"
  data-on:click="@get('{{.EditURL}}')" aria-label="Edit field">&#9998;</button>{{end}}
