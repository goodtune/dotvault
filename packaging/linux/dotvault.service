[Unit]
Description=dotvault — Vault-to-file secret synchronisation daemon
Documentation=https://github.com/goodtune/dotvault
Documentation=https://goodtune.github.io/dotvault/admin/deployment/

# Per-user daemon: authenticates to Vault as the OS user, reads
# ~/.dotvault-token from that user's $HOME, and syncs into
# kv/users/<username>/. As root it would do all three as root.
ConditionUser=!root

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=300
WatchdogSec=120

ExecStart=/usr/bin/dotvault run

# SIGHUP is the daemon's reload trigger: it re-reads ~/.dotvault-token and
# immediately re-runs the config loader, applying the dynamic sections
# (rules, enrolments, sync interval, remote_config) in place. Static
# sections (vault, web, agent, api, fuse, docker, observability,
# bypass_system_config) are logged as needing a restart.
ExecReload=/bin/kill -HUP $MAINPID

# %t/dotvault (i.e. $XDG_RUNTIME_DIR/dotvault), created 0700 and owned by
# this unit, is where the SSH agent socket, the local API socket
# (api.enabled), and the Docker volume plugin's socket and materialised
# volumes (docker.enabled) live. RuntimeDirectoryPreserve below is what
# keeps a running container's bind-mounted volume alive across a daemon
# restart — do not drop it. Declaring it here means systemd creates it before
# ExecStart. Note that $XDG_RUNTIME_DIR itself is torn down when the
# user's last session ends unless lingering is enabled
# (`loginctl enable-linger <user>`) — which is required anyway for a user
# service that is meant to outlive an SSH session, the exact case the local
# API socket exists to serve.
#
# Preserve= is load-bearing, not housekeeping preference. Without it,
# systemd removes %t/dotvault on every service stop — including
# Restart=on-failure cycles — and that directory holds the socket nodes the
# optional dotvault-api.socket / dotvault-agent.socket /
# dotvault-docker.socket units are listening on. Deleting them leaves the socket units holding fds for unlinked inodes
# (clients get ENOENT, not the promised backlog queueing) and makes the
# restarted daemon's activation check fail on the missing node: socket
# activation would break itself on the first restart, the exact event it
# exists to smooth over. The cost is that a *self-bound* socket's node can
# outlive a killed daemon, which the daemon's own bind path already handles
# (live-instance probe, stale-node removal). The directory itself is still
# removed with the runtime dir at session end.
RuntimeDirectory=dotvault
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal

EnvironmentFile=-%h/.config/dotvault/env
EnvironmentFile=-%h/.config/dotvault.env
EnvironmentFile=-/etc/default/dotvault
EnvironmentFile=-/etc/sysconfig/dotvault

# Deliberately no sandbox directives: they break fuse.enabled. The rule
# is broader than the four this unit used to carry (NoNewPrivileges=,
# RestrictNamespaces=, RestrictSUIDSGID=, LockPersonality=) — anything
# systemd implements with a seccomp filter is off limits here, including
# RestrictRealtime=, MemoryDenyWriteExecute=, ProtectClock=,
# ProtectKernelTunables/Modules/Logs=, PrivateDevices=, SystemCallFilter=
# and SystemCallArchitectures=.
#
# NoNewPrivileges= is the mechanism. It sets PR_SET_NO_NEW_PRIVS, which
# makes execve ignore the setuid bit and file capabilities for this
# process and, irrevocably, every descendant. The FUSE mount helper
# (fusermount3, or fusermount on fuse2 hosts) is privileged exactly that
# way, and it is the only mount path an unprivileged daemon has: go-fuse
# asks for mount(2) first (its DirectMount option), but that needs
# CAP_SYS_ADMIN, which a user manager cannot grant.
#
# The trap is that the rest re-imply it. systemd turns NoNewPrivileges=yes
# on for any seccomp-based directive in a unit that cannot install the
# filter otherwise, which is every user-manager service — so removing the
# explicit line while keeping its neighbours leaves the mount broken with
# nothing naming the cause. Where the running systemd predates a directive
# (RestrictSUIDSGID= is 242+, LockPersonality= 235+) or was built without
# seccomp it is ignored instead, giving neither hardening nor implication;
# that varies by distro, so do not lean on it.
#
# Little is lost. A per-user service already runs with the user's own
# authority, so these were defence in depth against an exploit that cannot
# persist, not a boundary. Full reasoning:
# https://goodtune.github.io/dotvault/admin/deployment/#hardening-and-the-fuse-mount
#
# UMask= is plain umask(2) — no seccomp, no capability, no effect on the
# mount — so the one piece of hardening that does work here stays.
UMask=0077

# There is no Protect*/Private* block for a different reason: those need
# CAP_SETPCAP / CAP_SYS_ADMIN and fail the spawn at step CAPABILITIES with
# exit 218 in a user manager.

[Install]
WantedBy=default.target
