{{/* The enrolment card, server-rendered. State markup mirrors the SPA's
     enrol-card.jsx so the /ui/ surface keeps the same look. While the
     enrolment is running the card polls its own fragment every 2s and the
     patch replaces the whole card — the poll stops naturally once a
     terminal state renders without the interval attribute. */}}
{{define "enrol-card"}}
{{if eq .Status "complete"}}
<div id="{{.ElementID}}" class="enrol-card enrol-complete" data-signals="{confirmReset: false}">
  <div class="enrol-card-header">
    <div><span class="enrol-check">&#10003;</span><strong>{{.Title}}</strong></div>
    <div class="enrol-card-actions">
      <span class="enrol-status-text enrol-status-complete">Enrolled successfully</span>
      <button class="enrol-btn-secondary" data-on:click="$confirmReset = true" {{if .Busy}}disabled{{end}}>Re-enrol</button>
    </div>
  </div>
  <div class="enrol-warn" data-show="$confirmReset" style="display: none">
    <p class="enrol-warn-text">This will overwrite your existing credentials. Are you sure?</p>
    <div class="enrol-warn-actions">
      <form class="ui-inline-form" method="post" action="{{.ActionBase}}/reset">
        <input type="hidden" name="key" value="{{.Key}}">
        <button class="enrol-btn-danger" {{if .Busy}}disabled{{end}}>Overwrite credentials</button>
      </form>
      <button class="enrol-btn-secondary" data-on:click="$confirmReset = false">Cancel</button>
    </div>
  </div>
</div>
{{else if eq .Status "skipped"}}
<div id="{{.ElementID}}" class="enrol-card enrol-skipped">
  <div class="enrol-card-header">
    <div><strong>{{.Title}}</strong><span class="enrol-badge">SKIPPED</span></div>
    <div class="enrol-card-actions">
      <span class="enrol-engine-desc">{{.EngineDesc}}</span>
      <form class="ui-inline-form" method="post" action="{{.ActionBase}}/reset">
        <input type="hidden" name="key" value="{{.Key}}">
        <button class="enrol-btn-secondary" {{if .Busy}}disabled{{end}}>Re-enrol</button>
      </form>
    </div>
  </div>
</div>
{{else if eq .Status "running"}}
{{/* The poll pauses while an engine is waiting on input: a patch replaces the
     whole card, so a 2s refresh would wipe whatever the user has typed into
     the passphrase field (and detach the element mid-click). The form submit
     re-renders the page, which resumes polling on the next state. */}}
<div id="{{.ElementID}}" class="enrol-card enrol-running"{{if not .PromptPending}} data-on-interval__duration.2s="@get('{{.FragmentURL}}')"{{end}}>
  <div class="enrol-card-header">
    <div><strong>{{.Title}}</strong><span class="enrol-badge enrol-badge-running">RUNNING</span></div>
  </div>
  {{if and .HasDeviceFlow (not .CodeSpent)}}
  <div class="enrol-device-flow">
    <p class="enrol-device-label">Enter this code on {{.EngineName}}:</p>
    <div class="enrol-device-code">{{.DeviceCode}}</div>
    <div class="enrol-device-actions">
      <a class="enrol-btn-secondary" href="{{.VerificationURL}}" target="_blank" rel="noopener noreferrer">Open {{.EngineName}} &#8594;</a>
    </div>
    <p class="enrol-device-waiting">{{if .ProgressLine}}{{.ProgressLine}}{{else}}Waiting for approval&#8230;{{end}}</p>
  </div>
  {{else if and .HasDeviceFlow .CodeSpent}}
  <div class="enrol-device-flow">
    <p class="enrol-device-label">&#10003; Signed in to {{.EngineName}}</p>
    <p class="enrol-device-waiting">{{.ProgressLine}}</p>
  </div>
  {{else if and .HasRedirectFlow (not .PromptPending) (not .RedirectSpent)}}
  <div class="enrol-device-flow">
    <p class="enrol-device-label">Sign in to {{.EngineName}} to continue:</p>
    <div class="enrol-device-actions">
      <a class="enrol-btn-primary" href="{{.VerificationURL}}" target="_blank" rel="noopener noreferrer">Open {{.EngineName}} &#8594;</a>
    </div>
    <p class="enrol-device-waiting">{{if .ProgressLine}}{{.ProgressLine}}{{else}}Waiting for authentication&#8230;{{end}}</p>
  </div>
  {{else if and .HasRedirectFlow (not .PromptPending) .RedirectSpent}}
  <div class="enrol-device-flow">
    <p class="enrol-device-label">&#10003; Signed in to {{.EngineName}}</p>
    <p class="enrol-device-waiting">{{.ProgressLine}}</p>
  </div>
  {{else if .PromptPending}}
  <form class="enrol-prompt-form" method="post" action="{{.ActionBase}}/secret">
    <input type="hidden" name="key" value="{{.Key}}">
    <label class="enrol-prompt-label" for="enrol-secret">{{.PromptLabel}}</label>
    <input type="password" id="enrol-secret" name="value" class="enrol-prompt-input" placeholder="Enter passphrase" autofocus>
    <div class="enrol-prompt-actions">
      <button type="submit" class="enrol-btn-primary">Submit</button>
    </div>
  </form>
  {{else if .Output}}
  <div class="enrol-output">{{range .Output}}<div>{{.}}</div>{{end}}</div>
  {{else}}
  <p class="enrol-device-waiting">Starting&#8230;</p>
  {{end}}
</div>
{{else if eq .Status "failed"}}
<div id="{{.ElementID}}" class="enrol-card enrol-failed">
  <div class="enrol-card-header">
    <div><strong>{{.Title}}</strong><span class="enrol-engine-desc">{{.EngineDesc}}</span></div>
    <div class="enrol-card-actions">
      <form class="ui-inline-form" method="post" action="{{.ActionBase}}/start">
        <input type="hidden" name="key" value="{{.Key}}">
        <button class="enrol-btn-primary" {{if .Busy}}disabled{{end}}>Retry</button>
      </form>
      <form class="ui-inline-form" method="post" action="{{.ActionBase}}/skip">
        <input type="hidden" name="key" value="{{.Key}}">
        <button class="enrol-btn-secondary" {{if .Busy}}disabled{{end}}>Skip</button>
      </form>
    </div>
  </div>
  {{if .HelpText}}<div class="custom-text enrol-help-text">{{.HelpText}}</div>{{end}}
  <p class="enrol-error-text">{{.Error}}</p>
</div>
{{else}}
<div id="{{.ElementID}}" class="enrol-card">
  <div class="enrol-card-header">
    <div><strong>{{.Title}}</strong><span class="enrol-engine-desc">{{.EngineDesc}}</span></div>
    <div class="enrol-card-actions">
      <form class="ui-inline-form" method="post" action="{{.ActionBase}}/start">
        <input type="hidden" name="key" value="{{.Key}}">
        <button class="enrol-btn-primary" {{if .Busy}}disabled{{end}}>Start</button>
      </form>
      <form class="ui-inline-form" method="post" action="{{.ActionBase}}/skip">
        <input type="hidden" name="key" value="{{.Key}}">
        <button class="enrol-btn-secondary" {{if .Busy}}disabled{{end}}>Skip</button>
      </form>
    </div>
  </div>
  {{if .HelpText}}<div class="custom-text enrol-help-text">{{.HelpText}}</div>{{end}}
</div>
{{end}}
{{end}}
