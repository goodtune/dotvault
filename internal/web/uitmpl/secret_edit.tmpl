{{define "content"}}
<div class="secret-heading">
  <h2 class="ui-page-heading">{{if .Creating}}New secret{{else}}{{.Path}}{{end}}</h2>
</div>
<p class="ui-page-subheading">
  {{if .Creating}}Create a secret in one of your editable key spaces.
  {{else}}Saving writes a new version of this secret, replacing every field.{{end}}
</p>
{{if .FormError}}<div class="error-banner">{{.FormError}}</div>{{end}}
<div class="enrol-card">
  <form class="secret-edit-form" method="post" action="/ui/secret-editor/save">
    <input type="hidden" name="create" value="{{if .Creating}}1{{else}}0{{end}}">
    {{if .Creating}}
      <label class="enrol-prompt-label" for="secret-path">Path</label>
      <input id="secret-path" name="path" class="enrol-prompt-input" value="{{.PathField}}"
             autocomplete="off" spellcheck="false" placeholder="personal/my-secret" required>
      {{if .Roots}}<p class="secret-edit-hint">Editable key spaces:
        {{range $i, $r := .Roots}}{{if $i}}, {{end}}<code>{{$r}}/</code>{{end}}
      </p>{{end}}
    {{else}}
      <input type="hidden" name="path" value="{{.Path}}">
    {{end}}
    <label class="enrol-prompt-label" for="secret-document">Fields (JSON)</label>
    <textarea id="secret-document" name="document" class="secret-edit-doc" rows="16"
              autocomplete="off" spellcheck="false" wrap="off" required>{{.Document}}</textarea>
    <p class="secret-edit-hint">The object&#8217;s keys become the secret&#8217;s fields.</p>
    <div class="enrol-prompt-actions">
      <button type="submit" class="enrol-btn-primary">{{if .Creating}}Create{{else}}Save{{end}}</button>
      <a class="enrol-btn-secondary" href="{{.CancelURL}}">Cancel</a>
    </div>
  </form>
</div>
{{end}}
